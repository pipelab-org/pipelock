            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "hash"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "unavailable"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "hash"
                  ]
                }
              ]
            }
          }
        }
      ],
      "minProperties": 1,
